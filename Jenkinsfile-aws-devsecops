pipeline {
    agent any

    tools {
        maven 'MAVEN3'
        jdk 'JDK17'
    }

    parameters {
        string(name: 'IMAGE_TAG', defaultValue: '', description: 'Optional custom image tag')
    }

    environment {
        IMAGE_REPO = "profilemappimg"
        BRANCH_NAME = "devsecops"
        // Replace with your real association ARN
        CODEGURU_ASSOCIATION_ARN = "arn:aws:codeguru-reviewer:ap-south-1:123456789012:association/xxxx-xxxx"
    }

    stages {

        stage("Clean Workspace") {
            steps { cleanWs() }
        }

        stage("Checkout Code") {
            steps {
                git branch: "${BRANCH_NAME}",
                    url: 'https://github.com/dushyantkumark/maven-devsecops-ecr-project.git'
            }
        }

        stage("Build Application") {
            steps {
                sh 'mvn clean install -DskipTests'
            }
        }

        // =========================
        // SAST - CodeGuru
        // =========================

        // stage("SAST - CodeGuru Review") {
        //     steps {
        //         withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'awscred']]) {
        //             sh '''
        //                 REVIEW_NAME="vprofile-review-$BUILD_NUMBER"

        //                 aws codeguru-reviewer create-code-review \
        //                   --name $REVIEW_NAME \
        //                   --repository-association-arn $CODEGURU_ASSOCIATION_ARN \
        //                   --type RepositoryAnalysis={RepositoryHead={BranchName=devsecops}}

        //                 echo "CodeGuru review triggered (non-blocking mode)."
        //             '''
        //         }
        //     }
        // }

        // =========================
        // Docker Build
        // =========================

        stage("Build Docker Image") {
            steps {
                script {
                    def tag = params.IMAGE_TAG?.trim() ? params.IMAGE_TAG : env.BUILD_NUMBER
                    env.TAG = tag
                    sh "docker build -t temp-image:${env.TAG} ."
                }
            }
        }

        // =========================
        // Push to ECR
        // =========================

        stage("Push to ECR") {
            steps {
                withCredentials([
                    string(credentialsId: 'accountid', variable: 'AWS_ACCOUNT_ID'),
                    string(credentialsId: 'region', variable: 'AWS_REGION'),
                    [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'awscred']
                ]) {
                    sh '''
                        ECR_URL=$AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com

                        aws ecr get-login-password --region $AWS_REGION \
                        | docker login --username AWS --password-stdin $ECR_URL

                        docker tag temp-image:$TAG $ECR_URL/$IMAGE_REPO:$TAG
                        docker push $ECR_URL/$IMAGE_REPO:$TAG
                    '''
                }
            }
        }

        // =========================
        // Inspector Report Only (No Fail Mode)
        // =========================

        stage("Inspector Security Report") {
            steps {
                withCredentials([
                    string(credentialsId: 'accountid', variable: 'AWS_ACCOUNT_ID'),
                    string(credentialsId: 'region', variable: 'AWS_REGION'),
                    [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'awscred']
                ]) {
                    sh '''
                        echo "Waiting for Amazon Inspector scan..."
                        sleep 40

                        echo "Downloading full findings..."

                        aws inspector2 list-findings \
                          --filter-criteria "{
                            \\"ecrImageRepositoryName\\":[{\\"comparison\\":\\"EQUALS\\",\\"value\\":\\"$IMAGE_REPO\\"}],
                            \\"ecrImageTags\\":[{\\"comparison\\":\\"EQUALS\\",\\"value\\":\\"$TAG\\"}]
                          }" \
                          --output json > inspector-findings.json

                        echo "Generating severity summary..."

                        CRITICAL=$(aws inspector2 list-findings \
                          --filter-criteria "{\\"severity\\":[{\\"comparison\\":\\"EQUALS\\",\\"value\\":\\"CRITICAL\\"}],\\"ecrImageRepositoryName\\":[{\\"comparison\\":\\"EQUALS\\",\\"value\\":\\"$IMAGE_REPO\\"}],\\"ecrImageTags\\":[{\\"comparison\\":\\"EQUALS\\",\\"value\\":\\"$TAG\\"}]}" \
                          --query "length(findings)" --output text)

                        HIGH=$(aws inspector2 list-findings \
                          --filter-criteria "{\\"severity\\":[{\\"comparison\\":\\"EQUALS\\",\\"value\\":\\"HIGH\\"}],\\"ecrImageRepositoryName\\":[{\\"comparison\\":\\"EQUALS\\",\\"value\\":\\"$IMAGE_REPO\\"}],\\"ecrImageTags\\":[{\\"comparison\\":\\"EQUALS\\",\\"value\\":\\"$TAG\\"}]}" \
                          --query "length(findings)" --output text)

                        MEDIUM=$(aws inspector2 list-findings \
                          --filter-criteria "{\\"severity\\":[{\\"comparison\\":\\"EQUALS\\",\\"value\\":\\"MEDIUM\\"}],\\"ecrImageRepositoryName\\":[{\\"comparison\\":\\"EQUALS\\",\\"value\\":\\"$IMAGE_REPO\\"}],\\"ecrImageTags\\":[{\\"comparison\\":\\"EQUALS\\",\\"value\\":\\"$TAG\\"}]}" \
                          --query "length(findings)" --output text)

                        LOW=$(aws inspector2 list-findings \
                          --filter-criteria "{\\"severity\\":[{\\"comparison\\":\\"EQUALS\\",\\"value\\":\\"LOW\\"}],\\"ecrImageRepositoryName\\":[{\\"comparison\\":\\"EQUALS\\",\\"value\\":\\"$IMAGE_REPO\\"}],\\"ecrImageTags\\":[{\\"comparison\\":\\"EQUALS\\",\\"value\\":\\"$TAG\\"}]}" \
                          --query "length(findings)" --output text)

                        echo "------------------------------------"
                        echo "Inspector Vulnerability Summary"
                        echo "CRITICAL : $CRITICAL"
                        echo "HIGH     : $HIGH"
                        echo "MEDIUM   : $MEDIUM"
                        echo "LOW      : $LOW"
                        echo "------------------------------------"

                        echo "CRITICAL: $CRITICAL" > inspector-summary.txt
                        echo "HIGH: $HIGH" >> inspector-summary.txt
                        echo "MEDIUM: $MEDIUM" >> inspector-summary.txt
                        echo "LOW: $LOW" >> inspector-summary.txt

                        echo "Report mode enabled. Pipeline will continue."
                    '''
                }
            }
        }

        stage("Archive Inspector Reports") {
            steps {
                archiveArtifacts artifacts: 'inspector-findings.json, inspector-summary.txt', allowEmptyArchive: true
            }
        }

        stage("Manual Approval") {
            steps {
                input message: "Approve Deployment?"
            }
        }

        stage("Deploy Container") {
            steps {
                withCredentials([
                    string(credentialsId: 'accountid', variable: 'AWS_ACCOUNT_ID'),
                    string(credentialsId: 'region', variable: 'AWS_REGION')
                ]) {
                    sh '''
                        ECR_URL=$AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com
                        IMAGE=$ECR_URL/$IMAGE_REPO:$TAG

                        docker stop vprofile || true
                        docker rm vprofile || true

                        docker run -d --name vprofile -p 80:8080 $IMAGE
                    '''
                }
            }
        }
    }

    post {
        success { echo "✅ AWS DevSecOps Pipeline Success (Report Mode)" }
        failure { echo "❌ Pipeline Failed" }
        always { cleanWs() }
    }
}
