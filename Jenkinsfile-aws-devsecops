pipeline {
    agent any

    tools {
        maven 'MAVEN3'
        jdk 'JDK17'
    }

    parameters {
        string(name: 'IMAGE_TAG', defaultValue: '', description: 'Optional custom image tag')
    }

    environment {
        IMAGE_REPO = "profilemappimg"
        BRANCH_NAME = "devsecops"
    }

    stages {

        stage("Clean Workspace") {
            steps { cleanWs() }
        }

        stage("Checkout Code") {
            steps {
                git branch: "${BRANCH_NAME}",
                    url: 'https://github.com/dushyantkumark/maven-devsecops-ecr-project.git'
            }
        }

        stage("Build Application") {
            steps {
                sh 'mvn clean install -DskipTests'
            }
        }

        // ✅ FIXED: Using classic docker build (NOT buildx)
        stage("Build Docker Image") {
            steps {
                script {
                    def tag = params.IMAGE_TAG?.trim() ? params.IMAGE_TAG : env.BUILD_NUMBER
                    env.TAG = tag

                    sh """
                        docker build \
                          -t temp-image:${env.TAG} .
                    """
                }
            }
        }

        stage("Push to ECR") {
            steps {
                withCredentials([
                    string(credentialsId: 'accountid', variable: 'AWS_ACCOUNT_ID'),
                    string(credentialsId: 'region', variable: 'AWS_REGION'),
                    [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'awscred']
                ]) {
                    sh '''
                        set -e

                        ECR_URL=$AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com

                        aws ecr get-login-password --region $AWS_REGION \
                        | docker login --username AWS --password-stdin $ECR_URL

                        docker tag temp-image:$TAG $ECR_URL/$IMAGE_REPO:$TAG
                        docker push $ECR_URL/$IMAGE_REPO:$TAG
                    '''
                }
            }
        }

        stage("Wait For Inspector Scan") {
            steps {
                withCredentials([
                    string(credentialsId: 'region', variable: 'AWS_REGION')
                ]) {
                    sh '''
                        echo "Waiting for Inspector scan..."

                        for i in {1..30}
                        do
                          STATUS=$(aws inspector2 list-coverage \
                            --filter-criteria "{
                              \\"ecrRepositoryName\\":[{\\"comparison\\":\\"EQUALS\\",\\"value\\":\\"$IMAGE_REPO\\"}],
                              \\"ecrImageTags\\":[{\\"comparison\\":\\"EQUALS\\",\\"value\\":\\"$TAG\\"}]
                            }" \
                            --region $AWS_REGION \
                            --query "coveredResources[0].scanStatus.statusCode" \
                            --output text)

                          echo "Scan Status: $STATUS"

                          if [ "$STATUS" = "ACTIVE" ]; then
                            echo "✅ Scan completed."
                            exit 0
                          fi

                          if [ "$STATUS" = "FAILED" ]; then
                            echo "❌ Scan failed."
                            exit 1
                          fi

                          sleep 20
                        done

                        echo "❌ Scan did not complete in time."
                        exit 1
                    '''
                }
            }
        }

        stage("Inspector Security Report (HTML)") {
            steps {
                withCredentials([
                    string(credentialsId: 'region', variable: 'AWS_REGION')
                ]) {
                    sh '''
                        echo "Fetching findings..."

                        aws inspector2 list-findings \
                          --filter-criteria "{
                            \\"ecrImageRepositoryName\\":[{\\"comparison\\":\\"EQUALS\\",\\"value\\":\\"$IMAGE_REPO\\"}],
                            \\"ecrImageTags\\":[{\\"comparison\\":\\"EQUALS\\",\\"value\\":\\"$TAG\\"}]
                          }" \
                          --region $AWS_REGION \
                          --output json > inspector-findings.json

                        CRITICAL=$(jq '[.findings[] | select(.severity=="CRITICAL")] | length' inspector-findings.json)
                        HIGH=$(jq '[.findings[] | select(.severity=="HIGH")] | length' inspector-findings.json)
                        MEDIUM=$(jq '[.findings[] | select(.severity=="MEDIUM")] | length' inspector-findings.json)
                        LOW=$(jq '[.findings[] | select(.severity=="LOW")] | length' inspector-findings.json)
                        TOTAL=$(jq '.findings | length' inspector-findings.json)

                        echo "Total: $TOTAL | Critical: $CRITICAL | High: $HIGH"

                        if [ "$CRITICAL" -gt 0 ]; then
                          echo "❌ Critical vulnerabilities found. Failing build."
                          exit 1
                        fi

                        cat <<EOF > inspector-report.html
<html>
<head><title>Amazon Inspector Report</title></head>
<body>
<h2>Amazon Inspector Vulnerability Summary</h2>
<ul>
<li>Total: $TOTAL</li>
<li>Critical: $CRITICAL</li>
<li>High: $HIGH</li>
<li>Medium: $MEDIUM</li>
<li>Low: $LOW</li>
</ul>
</body>
</html>
EOF
                    '''
                }
            }
        }

        stage("Archive Inspector Reports") {
            steps {
                archiveArtifacts artifacts: 'inspector-findings.json, inspector-report.html', allowEmptyArchive: true
            }
        }

        stage("Manual Approval") {
            steps {
                input message: "Approve Deployment?"
            }
        }

        stage("Deploy Container") {
            steps {
                withCredentials([
                    string(credentialsId: 'accountid', variable: 'AWS_ACCOUNT_ID'),
                    string(credentialsId: 'region', variable: 'AWS_REGION')
                ]) {
                    sh '''
                        ECR_URL=$AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com
                        IMAGE=$ECR_URL/$IMAGE_REPO:$TAG

                        docker stop vprofile || true
                        docker rm vprofile || true

                        docker run -d --name vprofile -p 80:8080 $IMAGE
                    '''
                }
            }
        }
    }

    post {
        success { echo "✅ AWS DevSecOps Pipeline Success (Inspector Compatible Mode)" }
        failure { echo "❌ Pipeline Failed" }
        always { cleanWs() }
    }
}
